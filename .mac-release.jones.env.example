# Disabled bootstrap identity. Copy to the ignored .mac-release.jones.env only for an authorized build.
JONES_BUNDLE_ID="com.jonessystems.codexbar"
JONES_DISPLAY_NAME="CodexBar Jones"
JONES_STATE_KEY="jones"
JONES_TEAM_ID="JONESLOCAL"
JONES_SIGNING_MODE="adhoc"
# No feed or trust key is activated by this example. All automatic update settings are false.
JONES_UPDATE_CHANNEL="none"
JONES_UPDATE_FEED_URL=""
JONES_UPDATE_PUBLIC_ED_KEY=""
# Stable requires all three explicit values: channel stable, the exact HTTPS URL below,
# and a separately approved Jones Ed25519 public key (canonical base64, exactly 32 bytes).
# Accepted URL: https://github.com/Jones-Systems/CodexBar/releases/latest/download/appcast.xml
# Signed feeds and pre-extraction verification remain required, with failure expiry zero.
# Build origin defaults to local. CI may explicitly request ci-pr or ci-main; packaging
# verifies GitHub repository/event/head context and derives JonesBuildRun from its run ID.
# Required only for an explicitly authorized identity-signed build; never use upstream's identity/profile.
# JONES_SIGNING_IDENTITY="REPLACE_WITH_YOUR_SIGNING_IDENTITY"
# JONES_PROVISIONING_PROFILE="/REPLACE/WITH/YOUR/PROFILE.provisionprofile"

# Opt-in production SOURCE support (not an approved signing or migration operation):
# Set JONES_SIGNING_MODE="developer-id", JONES_TEAM_ID="2CUPSQS986", and CODEXBAR_SIGNING=identity.
# Release only; no debugger entitlement. Channel MUST remain none while migration is held.
# JONES_SIGNING_IDENTITY must be the SHA-1 selector of the exact Jones Developer ID Application certificate.
# Both profiles must authorize that certificate, exact team, bundle IDs and app group.
# The app profile must also authorize CloudKit iCloud.com.jonessystems.codexbar in Production.
# JONES_WIDGET_PROVISIONING_PROFILE="/REPLACE/WITH/WIDGET/PROFILE.provisionprofile"
# The hosted workflow owns its ephemeral keychain and supplies JONES_SIGNING_KEYCHAIN.
# Never put passwords, P12 bytes or notary private keys in this shell configuration.
